# ==============================================================================
# RevenueRescue AI — Backend Environment Configuration Example
# Copy this file to '.env' for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash: cp .env.example .env
# NEVER COMMIT REAL API KEYS, PASSWORDS, OR SECRETS TO VERSION CONTROL!
# ==============================================================================

# Application Metadata
APP_NAME=RevenueRescue AI
APP_PHASE=foundation
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Connection (Default: local SQLite file for unit testing and fast setup)
DATABASE_URL=sqlite:///./revenuerescue.db

# Production / Docker PostgreSQL Example (Uncomment when running with Docker Compose):
# DATABASE_URL=postgresql+psycopg://revenuerescue:revenuerescue@localhost:5432/revenuerescue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Payment Gateway Configuration — Razorpay Sandbox (Test Mode)
# NEVER put real customer credentials or production API keys here!
PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_PROVIDER_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_PROVIDER_KEY_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret
PAYMENT_PROVIDER_BASE_URL=https://api.razorpay.com/v1
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10.0
PAYMENT_SIMULATE_SCENARIOS=true

# Optional External Integration Placeholders (Simulation mode is used by default)
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here

